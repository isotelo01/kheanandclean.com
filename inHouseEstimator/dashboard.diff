+/* Accepted estimate -> invoice. Its own I- number from meta/counters.invoice,
+   copied into "invoices" under a fresh id, then removed from "acceptedQuotes".
+   Copy first, delete second: a failure mid-way can never lose the record. */
+async function toInvoice(id, btn){
+  const src = await getDoc(doc(db, "acceptedQuotes", id));
+  if (!src.exists()) { alert("That accepted estimate is no longer there. Refresh the page."); return; }
+  const d = src.data();
+
+  const num = await runTransaction(db, async tx => {
+    const ref = doc(db, "meta", "counters");
+    const snap = await tx.get(ref);
+    const next = ((snap.exists() && snap.data().invoice) || 1000) + 1;
+    tx.set(ref, { invoice: next }, { merge: true });
+    return next;
+  });
+
+  const newId = Array.from(crypto.getRandomValues(new Uint8Array(20)))
+    .map(b => "abcdefghijklmnopqrstuvwxyz0123456789"[b % 36]).join("");
+
+  const inv = Object.assign({}, d, {
+    type: "invoice", status: "unpaid", number: "I-" + num,
+    quoteNumber: d.number || "", quoteId: id,
+    invoicedAt: serverTimestamp(), createdAt: d.createdAt || serverTimestamp()
+  });
+  delete inv.expiresAt;
+
+  await setDoc(doc(db, "invoices", newId), inv);
+  await deleteDoc(doc(db, "acceptedQuotes", id));
+  return "I-" + num;
+}
+
+boardEl.addEventListener("click", async e => {
+  const btn = e.target.closest(".invbtn");
+  if (!btn) return;
+  e.preventDefault();           /* the row is a link; don't follow it */
+  e.stopPropagation();
+  const id = btn.getAttribute("data-inv");
+  const row = (data.acceptedQuotes || []).find(r => r.id === id);
+  if (!confirm("Turn " + (row ? row.number : "this estimate") + " into an invoice?\n\nIt moves out of Accepted Estimates.")) return;
+  btn.disabled = true; btn.textContent = "Working\u2026";
+  try {
+    await toInvoice(id, btn);
+    await load();
+  } catch (err) {
+    console.error(err);
+    btn.disabled = false; btn.textContent = "Invoice";
+    alert("That didn't go through. If it keeps failing, check the Firestore Rules \u2014 writes to \"invoices\" or deletes from \"acceptedQuotes\" may be blocked.");
+  }
+});
+
+/* Trash is a move, not an erase: the doc is copied to "trash" with a note of the
+   collection it came from, so Restore can put it back where it was. */
+async function toTrash(id, from){
+  const src = await getDoc(doc(db, from, id));
+  if (!src.exists()) return;
+  const d = src.data();
+  await setDoc(doc(db, "trash", id), Object.assign({}, d, {
+    trashedFrom: from, trashedAt: serverTimestamp()
+  }));
+  await deleteDoc(doc(db, from, id));
+}
+
+async function restore(id){
+  const src = await getDoc(doc(db, "trash", id));
+  if (!src.exists()) return;
+  const d = src.data();
+  const back = d.trashedFrom || "quotes";
+  const clean = Object.assign({}, d);
+  delete clean.trashedFrom; delete clean.trashedAt;
+  await setDoc(doc(db, back, id), clean);
+  await deleteDoc(doc(db, "trash", id));
+}
+
+document.getElementById("trashToggle").addEventListener("click", e => {
+  showTrash = !showTrash;
+  e.currentTarget.setAttribute("aria-pressed", String(showTrash));
+  document.getElementById("pageTitle").textContent = showTrash ? "Trash" : "Estimates";
+  render();
+});
+
+boardEl.addEventListener("click", async e => {
+  const del = e.target.closest(".del"), res = e.target.closest(".restore");
+  if (!del && !res) return;
+  e.preventDefault(); e.stopPropagation();
+  const btn = del || res;
+  btn.disabled = true;
+  try {
+    if (del) await toTrash(del.getAttribute("data-del"), del.getAttribute("data-from"));
+    else await restore(res.getAttribute("data-restore"));
+    await load();
+  } catch (err) {
+    console.error(err);
+    btn.disabled = false;
+    alert("That didn't go through. If it keeps failing, check the Firestore Rules \u2014 writes to \"trash\" or deletes may be blocked.");
+  }
+});
+
 qEl.addEventListener("input", render);
 load();
