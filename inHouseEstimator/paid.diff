+/* Invoice -> paid. Same id, so a link already sent still resolves. */
+async function toPaid(id){
+  const src = await getDoc(doc(db, "invoices", id));
+  if (!src.exists()) { alert("That invoice is no longer there. Refresh the page."); return; }
+  await setDoc(doc(db, "paidInvoices", id), Object.assign({}, src.data(), {
+    status: "paid", paidAt: serverTimestamp()
+  }));
+  await deleteDoc(doc(db, "invoices", id));
+}
