+  /* Job history: paid invoices whose customer phone matches this one. */
+  async function loadJobs(){
+    const box = $("jobs");
+    if (!box || isNew) return;
+    const pk = phoneKey(c.phone);
+    if (!pk) { box.textContent = "Add a phone number to match up past jobs."; return; }
+    try {
+      const snap = await getDocs(collection(db, "paidInvoices"));
+      const rows = snap.docs
+        .map(d => ({ id: d.id, ...d.data() }))
+        .filter(r => phoneKey(r.customer && r.customer.phone) === pk)
+        .map(r => ({ ...r, ms: anyMs(r.paidAt) }))
+        .sort((a, b) => (b.ms || 0) - (a.ms || 0));
+      if (!rows.length) { box.textContent = "No paid jobs yet."; return; }
+      box.innerHTML = rows.map(r =>
+        '<a class="job" href="./quote.html?id=' + encodeURIComponent(r.id) + '" target="_blank" rel="noopener">' +
+          '<span class="job__date">' + esc(shortDate(r.ms) || "\u2014") + '</span>' +
+          '<span class="job__no">' + esc(r.number || "") + '</span>' +
+          '<span class="job__total">' + esc(money(r.total)) + '</span>' +
+        '</a>').join("");
+    } catch (e) {
+      console.error(e);
+      box.textContent = "Could not load job history.";
+    }
+  }
+  loadJobs();
+
