+
+/* Forgot password: Firebase emails a reset link to whatever is in the Email box.
+   The message is the same whether or not the address has an account, so the
+   page never reveals which emails are registered. */
+const forgot = document.getElementById("forgotBtn");
+forgot.addEventListener("click", async () => {
+  const emailEl = document.getElementById("email");
+  const email = emailEl.value.trim();
+  err.classList.remove("ok");
+  if (!email) { err.textContent = "Type your email above first, then tap Forgot password."; emailEl.focus(); return; }
+  forgot.disabled = true;
+  try {
+    await sendPasswordResetEmail(auth, email);
+    err.classList.add("ok");
+    err.textContent = "If that email has an account, a reset link is on its way. Check spam too.";
+  } catch (ex) {
+    console.error(ex);
+    if (ex.code === "auth/user-not-found") {
+      err.classList.add("ok");
+      err.textContent = "If that email has an account, a reset link is on its way. Check spam too.";
+    } else {
+      err.textContent = SAYS[ex.code] || "Could not send the reset email. Try again.";
+    }
+  }
+  forgot.disabled = false;
+});
